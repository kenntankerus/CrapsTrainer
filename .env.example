# Copy this to .env and fill it in. Every setting is optional except BASE_URL and the email ones.

# Where people reach the site (used in the sign-in links). https:// also marks the cookie secure.
CRAPS_BASE_URL=https://craps.kbmoto.net

# Email for the sign-in links, from an email service's SMTP settings (Resend shown here).
CRAPS_SMTP_HOST=smtp.resend.com
CRAPS_SMTP_PORT=587
CRAPS_SMTP_SECURITY=starttls
CRAPS_SMTP_USER=resend
CRAPS_SMTP_PASSWORD=
CRAPS_MAIL_FROM=Craps Trainer <login@kbmoto.net>

# Cloudflare Turnstile, the bot check on the sign-in form (Cloudflare dashboard > Turnstile). Leave empty for none.
CRAPS_TURNSTILE_SITE_KEY=
CRAPS_TURNSTILE_SECRET=

# Behind a Cloudflare Tunnel: read the visitor's address from Cloudflare's header (for the rate limits).
CRAPS_TRUST_PROXY=1

# Where the database, dice pictures and voice clips are kept (the Docker setup mounts ./data here).
# CRAPS_DATA_DIR=/app/data
# CRAPS_TTS=1

# The Cloudflare Tunnel's token (Zero Trust > Networks > Tunnels), read by docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# The webcam at the table (see web/README.md, "The camera"). Only the accounts listed may start it or see
# its picture. 0 is the first camera; "demo" is a pretend camera that throws drawn dice, for trying it out.
# CRAPS_CAMERA=0
# CRAPS_CAMERA_USERS=you@example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.camera.yml

# The stickman's voices (see web/README.md, "The stickman's voice").
# ElevenLabs: your key, and the voice ID of each character you designed there (Name=ID; Name=ID).
# CRAPS_ELEVENLABS_API_KEY=
# CRAPS_ELEVENLABS_VOICES=Precious (Gollum-ish)=VOICE_ID; Shean (Connery-ish)=VOICE_ID
# Who gets personal calls ("Pay the hard eight, forty-five dollars") from ElevenLabs; the camera users if empty.
# CRAPS_PREMIUM_USERS=you@example.com
# The most characters sent to ElevenLabs in a day, so a busy night can't run up a bill (0 = no limit).
# CRAPS_ELEVENLABS_DAILY_CHARS=20000
